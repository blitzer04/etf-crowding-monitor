# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Virtual environments and local configuration
.venv/
venv/
.env
.env.*
.streamlit/secrets.toml

# Packaging output
build/
dist/
*.egg-info/

# Coverage output
.coverage
.coverage.*
coverage.xml
htmlcov/

# Generated data; retain stage directories in Git
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/snapshots/*
!data/snapshots/.gitkeep

# IDE and operating-system files
.idea/
.vscode/
*.code-workspace
.DS_Store
Thumbs.db
